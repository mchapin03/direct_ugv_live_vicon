          ixz="0.0"
          iyy="${caster_wheel_mass * 0.4 * caster_wheel_radius * caster_wheel_radius}"
          iyz="0.0"
          izz="${caster_wheel_mass * 0.4 * caster_wheel_radius * caster_wheel_radius}"/>
      </inertial>
    </link> -->

        <!-- LiDAR properties -->
    <xacro:property name="lidar_x_position" value="0.1"/> <!-- Center the LiDAR on back axle (x=0) -->
    <xacro:property name="lidar_y_position" value="0.0"/> <!-- LiDAR centered on y-axis (y=0) -->
    <xacro:property name="lidar_height" value="0.15"/> <!-- height -->
    <xacro:property name="lidar_angle" value="0"/> <!-- LiDAR orientation in radians (0 for horizontal) -->

    <!-- LiDAR link -->
    <link name="laser">
        <visual>
            <origin xyz="${lidar_x_position} ${lidar_y_position} ${lidar_height}" rpy="0 ${lidar_angle} 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.1"/> <!-- Adjust size of the LiDAR -->
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="${lidar_x_position} ${lidar_y_position} ${lidar_height}" rpy="0 ${lidar_angle} 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.1"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.5"/> <!-- Adjust LiDAR mass if needed -->
            <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>

    <!-- LiDAR joint -->
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="${lidar_x_position} ${lidar_y_position} ${lidar_height}" rpy="0 ${lidar_angle} 0"/>
    </joint>

  </xacro:macro>

</robot>